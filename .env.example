# Free key: https://finnhub.io/register  (60 calls/min on the free tier)
# Without this key the app still runs — the Stocks section shows a setup hint.
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Web Push (closed-tab alerts). All optional — without them the app falls back
# to in-tab notifications only and the push UI hides itself.
# ---------------------------------------------------------------------------
# Generate a keypair once with:  npm run gen-vapid
# Public key is exposed to the browser; private key stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https URL identifying you (required by the push spec).
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis (free tier) — stores push subscriptions AND backs per-IP API
# rate limiting (src/middleware.ts). Without it the limiter fails open (allows
# all traffic), so set this in production. Create a database at
# https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Inngest — primary scheduler for the push cron (runs /api/inngest every 5m).
# ---------------------------------------------------------------------------
# Absolute base URL of this deployment, used by the scheduled function to read
# the app's own market-data routes. On Vercel this falls back to VERCEL_URL
# automatically; set explicitly for a stable custom domain.
APP_URL=https://your-app.vercel.app
# Signing key authenticates Inngest <-> /api/inngest. This is the only key our
# cron-triggered function needs (or let the Vercel <-> Inngest integration set
# it). Leave blank locally when using `npx inngest-cli dev`.
INNGEST_SIGNING_KEY=
# Event key is ONLY needed if the app sends events via inngest.send(). Our
# function is cron-triggered, so this can stay blank/unset.
# INNGEST_EVENT_KEY=
